# ETA Prediction Pipeline - Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# GTFS-RT Data Ingestion (Django + Celery)
# =============================================================================

# Django Configuration
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django

# PostgreSQL Database
DATABASE_URL=postgresql://gtfs:gtfs@postgres:5432/gtfs

# GTFS-RT Feed URLs (default: MBTA Boston)
GTFSRT_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
GTFSRT_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
FEED_NAME=mbta

# Ingestion Polling Interval (seconds)
POLL_SECONDS=30

# =============================================================================
# ETA Prediction Service
# =============================================================================

# Model Registry
MODEL_REGISTRY_DIR=/app/models/trained

# Which agency's timezone + holiday calendar the estimator uses for temporal
# features (see core/config.py:AGENCY_TEMPORAL_DEFAULTS). Must match the
# agency the served models were trained on. This also selects the pinned
# served model via core/config.py:AGENCY_MODEL_DEFAULTS (see below) -- bucr
# pins the BUCR corpus XGBoost model so the databus path never falls back to
# an MBTA model even though the registry still holds MBTA entries.
ETA_AGENCY=bucr

# Explicit overrides, only needed to deviate from ETA_AGENCY's defaults:
# ETA_TIMEZONE=America/Costa_Rica
# ETA_HOLIDAY_REGION=CR

# Served-model pin overrides (rarely needed): by default the agency's entry
# in core/config.py:AGENCY_MODEL_DEFAULTS is used (for bucr: the corpus
# XGBoost model, falling back to the corpus PolyReg-distance model if the
# primary key is missing from the registry). Set these only to point at a
# different trained model without editing code, e.g. after promoting a new
# BUCR model.
# ETA_MODEL_KEY=xgboost_bucr_segments_corpus_spatial-temporal_global_20260824_215905_handle_nan=drop_learning_rate=0.05_max_depth=5_n_estimators=200
# ETA_MODEL_FALLBACK_KEY=polyreg_distance_bucr_segments_corpus_distance_global_20260824_215904_degree=2_route_specific=no

# Debug Mode (1 = verbose logging)
ETA_DEBUG=0

# JSON Logging (1 = structured JSON logs)
ETA_LOG_JSON=0

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# =============================================================================
# MQTT Configuration (vehicle telemetry bridge, consumed via Redis by Prefect)
# =============================================================================

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=admin
MQTT_PASS=admin
MQTT_TOPIC=transit/vehicles/bus/#

# =============================================================================
# Prefect Configuration (optional)
# =============================================================================

# Prefect API URL (if using Prefect Cloud or self-hosted server)
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/.../workspaces/...
# PREFECT_API_KEY=your-api-key

# =============================================================================
# Production Overrides
# =============================================================================

# Uncomment and customize for production deployments:

# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=your-production-secret-key
# DATABASE_URL=postgresql://user:password@production-db:5432/gtfs

# Costa Rica GTFS-RT feeds (example):
# GTFSRT_VEHICLE_POSITIONS_URL=https://your-feed-url/VehiclePositions.pb
# GTFSRT_TRIP_UPDATES_URL=https://your-feed-url/TripUpdates.pb
# FEED_NAME=cr
