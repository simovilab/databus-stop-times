#!/usr/bin/env python3
"""One-screen health check for the SIMOVI collectors.

Answers, in order of how often you actually need it:
  1. Is data still arriving?          (poll age)
  2. Is it reaching S3?               (spool size + last flush)
  3. Is it being consolidated?        (nightly compaction + staging backlog)
  4. Will it keep working?            (inode / disk runway on the MinIO box)

Reads the status snapshots the collectors write to /var/lib/simovi/status and
queries MinIO + the local host. Never raises: a section that cannot be read
prints as unavailable rather than taking the whole report down with it.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone

STATUS_DIR = os.environ.get("SIMOVI_STATUS_DIR", "/var/lib/simovi/status")
# Mirrors COMPACT_HOUR_UTC / COMPACT_MINUTE in ingestproj/settings.py. Only
# used to say when the next run is due; a wrong value here misreports the
# countdown, never the health verdict.
COMPACT_HOUR = int(os.environ.get("SIMOVI_COMPACT_HOUR", "3"))
COMPACT_MINUTE = int(os.environ.get("SIMOVI_COMPACT_MINUTE", "15"))
ALIAS = os.environ.get("SIMOVI_MC_ALIAS", "simovilab")
BUCKET = os.environ.get("SIMOVI_BUCKET", "transit")

TTY = sys.stdout.isatty()


def c(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if TTY else text


def dim(t):  return c(t, "2")
def bold(t): return c(t, "1")
def green(t): return c(t, "32")
def yellow(t): return c(t, "33")
def red(t):  return c(t, "31")


def run(cmd: list[str], timeout: int = 20) -> str | None:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout if p.returncode == 0 else None
    except Exception:
        return None


# ── formatting helpers ────────────────────────────────────────────────────────

def ago(ts: datetime | None, now: datetime) -> str:
    """Human elapsed time. This is the number you actually read, so it must be
    legible at a glance -- '4s ago', not an ISO timestamp to subtract by eye."""
    if ts is None:
        return "never"
    s = (now - ts).total_seconds()
    if s < 0:
        return "just now"
    if s < 60:
        return f"{int(s)}s ago"
    if s < 3600:
        return f"{int(s // 60)}m ago"
    if s < 86400:
        return f"{int(s // 3600)}h {int((s % 3600) // 60)}m ago"
    return f"{int(s // 86400)}d ago"


def until(target: datetime, now: datetime) -> str:
    s = (target - now).total_seconds()
    if s < 0:
        return "due"
    if s < 60:
        return f"in {int(s)}s"
    if s < 3600:
        return f"in {int(s // 60)}m"
    # Daily jobs are hours out; "in 1230m" is technically right and useless.
    return f"in {int(s // 3600)}h {int((s % 3600) // 60)}m"


def next_daily(now: datetime, hour: int, minute: int) -> datetime:
    cand = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    if cand <= now:
        cand += timedelta(days=1)
    return cand


def pct_change(before, after) -> str | None:
    """"120k → 96k (-20%)" for a pair of row counts, or None if either is
    missing. Compaction is judged by how much it removed, so the delta is the
    number worth rendering, not the two totals on their own."""
    if not isinstance(before, int) or not isinstance(after, int) or before <= 0:
        return None
    delta = (after - before) / before * 100
    # A run that removed 0.3% must not render as "(-0%)" -- on a dedupe job
    # that reads as "did nothing" when it in fact removed a thousand rows.
    fmt = f"{delta:+.1f}%" if abs(delta) < 1 else f"{delta:+.0f}%"
    return f"{human_count(before)} → {human_count(after)} ({fmt})"


def parse_ts(v) -> datetime | None:
    if not v or not isinstance(v, str):
        return None
    try:
        d = datetime.fromisoformat(v.replace("Z", "+00:00"))
        return d if d.tzinfo else d.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def human_bytes(n: float | int | None) -> str:
    if n is None:
        return "?"
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if abs(n) < 1024 or unit == "TB":
            return f"{n:,.0f} {unit}" if unit == "B" else f"{n:,.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def human_count(n: int | None) -> str:
    if n is None:
        return "?"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(n)


def bar(pct: float, width: int = 12) -> str:
    filled = max(0, min(width, round(pct / 100 * width)))
    glyph = "█" * filled + "·" * (width - filled)
    if pct >= 85:
        return red(glyph)
    if pct >= 65:
        return yellow(glyph)
    return green(glyph)


def dot(state: str) -> str:
    return {"ok": green("●"), "warn": yellow("●"), "bad": red("●")}.get(state, "●")


def row(label: str, value: str, extra: str = "") -> None:
    print(f"    {dim(label.ljust(13))}{value.ljust(30)}{dim(extra)}")


# ── feeds ─────────────────────────────────────────────────────────────────────

def read_status(name: str) -> dict:
    path = os.path.join(STATUS_DIR, f"{name}.json")
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def next_flush(now: datetime, minute: int) -> datetime:
    """MBTA flushes at a fixed minute past the hour; bUCR on the hour boundary."""
    cand = now.replace(minute=minute, second=0, microsecond=0)
    if cand <= now:
        cand += timedelta(hours=1)
    return cand


def feed_panel(title: str, name: str, now: datetime, *, cadence: str,
               flush_minute: int, extra_lines: list[tuple[str, str, str]] | None = None) -> str:
    st = read_status(name)
    if not st:
        print(f"  {dot('bad')} {bold(title.ljust(14))}{red('no status file')} {dim(STATUS_DIR)}")
        print()
        return "bad"

    last_poll = parse_ts(st.get("last_poll_utc"))
    age = (now - last_poll).total_seconds() if last_poll else None

    # A collector is judged on whether data is still arriving, nothing else.
    # A stale poll is the failure that matters; everything else is detail.
    if age is None:
        state, verdict = "bad", "never polled"
    elif age > 300:
        state, verdict = "bad", f"STALLED — no poll in {ago(last_poll, now)}"
    elif age > 60:
        state, verdict = "warn", f"slow — last poll {ago(last_poll, now)}"
    else:
        state, verdict = "ok", f"healthy · polling every {cadence}"

    print(f"  {dot(state)} {bold(title.ljust(14))}{verdict}")

    fetched, new = st.get("rows_fetched"), st.get("rows_new")
    row("last poll", ago(last_poll, now),
        f"fetched {fetched:,}, new {new:,}" if isinstance(fetched, int) and isinstance(new, int) else "")

    spool_rows = st.get("spool_rows")
    spool_bytes = st.get("spool_bytes")
    nf = next_flush(now, flush_minute)
    row("spool",
        f"{spool_rows:,} rows · {human_bytes(spool_bytes)}" if isinstance(spool_rows, int) else "?",
        f"next flush {nf:%H:%M} ({until(nf, now)})")

    lf = parse_ts(st.get("last_flush_utc"))
    lf_rows = st.get("last_flush_rows")
    if lf:
        key = st.get("last_flush_key") or ""
        key = key.rsplit("/", 1)[-1] if "/" in key else key
        row("last flush", ago(lf, now),
            f"{lf_rows:,} rows" + (f" → {key}" if key else "") if isinstance(lf_rows, int) else "")
    else:
        row("last flush", dim("none yet"), "first flush lands on the next boundary")

    # Weekly, so "stale" means days not minutes -- a run every Monday leaves
    # up to ~8 days between snapshots even when nothing is wrong.
    ls = parse_ts(st.get("last_static_snapshot_utc"))
    if ls:
        stale = (now - ls).total_seconds() > 8 * 86400
        row("static gtfs", red(ago(ls, now)) if stale else ago(ls, now),
            human_bytes(st.get("last_static_snapshot_bytes")))
    else:
        row("static gtfs", dim("none yet"), "first snapshot lands the next Monday 04:00 UTC")

    for lbl, val, ext in (extra_lines or []):
        row(lbl, val, ext)

    # Errors are shown as a condition, not a log line: a stale last_error from
    # hours ago is history, and rendering it like a live alarm is what made the
    # previous version unreadable.
    err_ts = parse_ts(st.get("last_error_utc"))
    err = st.get("last_error")
    if err and err_ts and (now - err_ts).total_seconds() < 3600:
        short = str(err).split("\n")[0][:60]
        row("errors", red(f"{ago(err_ts, now)}"), short)
    elif err and err_ts:
        row("errors", green("none recent"), f"last was {ago(err_ts, now)}")
    else:
        row("errors", green("none"), "")

    print()
    return state


# ── TripUpdates replay archive ────────────────────────────────────────────────

def tu_panel(now: datetime, *, flush_minute: int = 7) -> str:
    """The TU archive is opt-in (TU_ARCHIVE_ENABLED), so an absent status file
    means "never switched on", not "broken". Rendering that as a red failure
    would cry wolf on every host that has simply not enabled it -- so it
    reports `off`, and never contributes a `bad` state to the exit code."""
    st = read_status("mbta_tu")
    if not st:
        print(f"  {dim('○')} {bold('MBTA TU'.ljust(14))}{dim('archive off')}"
              f"  {dim('set TU_ARCHIVE_ENABLED=true to collect for replay runs')}")
        print()
        return "off"

    last_poll = parse_ts(st.get("last_poll_utc"))
    age = (now - last_poll).total_seconds() if last_poll else None
    cadence = st.get("poll_seconds")
    # Judged against its own beat, not the VP one: this polls every 30s by
    # default, so the 60s/300s thresholds used for a 5s feed would be wrong.
    slow = (cadence * 4) if isinstance(cadence, int) else 120
    stalled = (cadence * 20) if isinstance(cadence, int) else 600

    if age is None:
        state, verdict = "bad", "never polled"
    elif age > stalled:
        state, verdict = "bad", f"STALLED — no poll in {ago(last_poll, now)}"
    elif age > slow:
        state, verdict = "warn", f"slow — last poll {ago(last_poll, now)}"
    else:
        state, verdict = "ok", f"archiving · polling every {cadence}s"

    print(f"  {dot(state)} {bold('MBTA TU'.ljust(14))}{verdict}")

    # The scope line is the storage bill. "ALL ROUTES" is ~80x the corpus
    # routes, so it is called out in yellow rather than shown as a neutral
    # fact -- an accidentally-empty TU_ROUTES is the expensive mistake here.
    routes = st.get("archive_routes")
    horizon = st.get("archive_horizon_s")
    scope = red("ALL ROUTES") if routes == "ALL ROUTES" else (routes or "?")
    row("scope", scope,
        f"horizon ≤ {int(horizon) // 60}m" if isinstance(horizon, int) else "")

    fetched, new = st.get("rows_fetched"), st.get("rows_new")
    row("last poll", ago(last_poll, now),
        f"fetched {fetched:,}, new {new:,}"
        if isinstance(fetched, int) and isinstance(new, int) else "")

    spool_rows, spool_bytes = st.get("spool_rows"), st.get("spool_bytes")
    nf = next_flush(now, flush_minute)
    row("spool",
        f"{spool_rows:,} rows · {human_bytes(spool_bytes)}"
        if isinstance(spool_rows, int) else "?",
        f"next flush {nf:%H:%M} ({until(nf, now)})")

    lf = parse_ts(st.get("last_flush_utc"))
    drained, written = st.get("last_flush_rows"), st.get("last_flush_rows_written")
    if lf:
        # Two numbers, because they differ on purpose: rows leave the spool,
        # but repeats of the previous prediction are run-length encoded away
        # before anything is written. The gap between them IS the feature.
        if isinstance(drained, int) and isinstance(written, int) and drained > 0:
            saved = (1 - written / drained) * 100
            detail = f"{drained:,} drained → {written:,} written ({saved:.0f}% repeats dropped)"
        elif isinstance(drained, int):
            detail = f"{drained:,} rows"
        else:
            detail = ""
        row("last flush", ago(lf, now), detail)
    else:
        row("last flush", dim("none yet"), "first flush lands on the next boundary")

    err_ts = parse_ts(st.get("last_error_utc"))
    err = st.get("last_error")
    if err and err_ts and (now - err_ts).total_seconds() < 3600:
        row("errors", red(f"{ago(err_ts, now)}"), str(err).split("\n")[0][:60])
    elif err and err_ts:
        row("errors", green("none recent"), f"last was {ago(err_ts, now)}")
    else:
        row("errors", green("none"), "")

    print()
    return state


# ── compaction ────────────────────────────────────────────────────────────────

def compaction_row(label: str, name: str, now: datetime) -> str:
    """One feed's nightly staging → curated run.

    Compaction is the failure nobody notices: polls and flushes keep looking
    perfectly healthy while staging quietly piles up and the curated dataset
    goes stale. So it gets judged on its own age -- a daily job that has not
    run in over 26h is broken, whatever the rest of the report says.
    """
    st = read_status(name)
    lc = parse_ts(st.get("last_compaction_utc"))
    if not lc:
        row(label, dim("never run"), "no compaction recorded for this feed")
        return "unknown"

    errors = st.get("last_compaction_errors")
    age = (now - lc).total_seconds()
    if age > 26 * 3600:
        state, when = "bad", red(ago(lc, now))
    elif errors:
        state, when = "warn", yellow(ago(lc, now))
    else:
        state, when = "ok", ago(lc, now)

    day = st.get("last_compaction_day") or "?"
    files = st.get("last_compaction_files")
    dupes = st.get("last_compaction_dupes_removed")
    rows = pct_change(st.get("last_compaction_rows_in"), st.get("last_compaction_rows_out"))

    detail = [f"day {day}"]
    if isinstance(files, int):
        detail.append(f"{files} file{'s' if files != 1 else ''}")
    if rows:
        detail.append(rows)
    if isinstance(dupes, int) and dupes:
        detail.append(f"{dupes:,} dupes removed")
    if errors:
        detail.append(red(f"{errors} error(s)"))

    row(label, when, " · ".join(detail))
    return state


def compaction_panel(now: datetime) -> str:
    print(f"  {bold('COMPACTION')}  {dim('staging → curated, nightly')}")

    states = [compaction_row("mbta", "mbta", now),
              compaction_row("bucr", "navsat", now)]

    # Staging backlog is the corroborating signal: a stale last_compaction_utc
    # says the job did not run, a growing staging count says it is not keeping
    # up. Reading them together is what tells the two apart.
    counts = {}
    for label, prefix in (("mbta", "feeds/mbta/vehicle_positions_staging/"),
                          ("bucr", "feeds/bucr/navsat_staging/"),
                          ("mbta tu", "feeds/mbta/trip_updates_staging/")):
        o = run(["mc", "ls", "--recursive", f"{ALIAS}/{BUCKET}/{prefix}"])
        counts[label] = len(o.strip().splitlines()) if o and o.strip() else 0

    # The TU archive is staging-only by design -- nothing compacts it, so its
    # objects are expected to accumulate and must not be read as a backlog.
    backlog = counts["mbta"] + counts["bucr"]
    if backlog > 60:
        note = red("HIGH — compaction is not keeping up")
    elif backlog == 0:
        note = dim("all compacted")
    else:
        note = dim("awaiting tonight's run")
    row("staging", f"mbta {counts['mbta']} · bucr {counts['bucr']}", note)
    if counts["mbta tu"]:
        row("tu archive", f"{counts['mbta tu']} objects",
            dim("staging is the final layout here — never compacted"))

    nr = next_daily(now, COMPACT_HOUR, COMPACT_MINUTE)
    row("next run", f"{nr:%H:%M} UTC", until(nr, now).replace("in ", "in "))
    print()
    return "bad" if "bad" in states else "ok"


# ── storage ───────────────────────────────────────────────────────────────────

def storage_panel(now: datetime) -> None:
    print(f"  {bold('STORAGE')}  {dim('data.simovilab.org (MinIO)')}")

    out = run(["mc", "admin", "info", "--json", ALIAS])
    if not out:
        row("status", red("unreachable"), "mc admin info failed")
        print()
        return

    try:
        info = json.loads(out).get("info", {})
        drive = info["servers"][0]["drives"][0]
    except Exception:
        row("status", red("unparseable"), "")
        print()
        return

    total, used = drive.get("totalspace", 0), drive.get("usedspace", 0)
    disk_pct = used / total * 100 if total else 0
    row("disk", f"{human_bytes(used)} / {human_bytes(total)}",
        f"{bar(disk_pct)} {disk_pct:.0f}%")

    used_i, free_i = drive.get("used_inodes", 0), drive.get("free_inodes", 0)
    total_i = used_i + free_i
    inode_pct = used_i / total_i * 100 if total_i else 0
    row("inodes", f"{human_count(used_i)} / {human_count(total_i)}",
        f"{bar(inode_pct)} {inode_pct:.0f}%")

    objects = info.get("objects", {}).get("count")
    # The runway is the number that matters. MinIO spends ~2.5 inodes per
    # object; at the pre-2026-08-14 write pattern (~500k objects/day) this
    # drive had roughly ten days of headroom, which is exactly how the
    # original incident happened. At ~165/day it is effectively unbounded.
    per_day = 165 * 2.5
    runway_days = free_i / per_day if per_day else 0
    if runway_days > 3650:
        runway = green("years of headroom at the current write rate")
    elif runway_days > 365:
        runway = green(f"~{runway_days / 365:.0f}y at the current write rate")
    elif runway_days > 90:
        runway = yellow(f"~{runway_days:.0f}d — fine for the 90-day run")
    else:
        runway = red(f"~{runway_days:.0f}d — WILL RUN OUT before 90 days")
    row("objects", f"{objects:,} total" if objects else "?", runway)

    print()


def host_panel() -> None:
    print(f"  {bold('VPS')}      {dim(os.uname().nodename)}")

    try:
        du = shutil.disk_usage("/")
        pct = du.used / du.total * 100
        row("disk", f"{human_bytes(du.used)} / {human_bytes(du.total)}",
            f"{bar(pct)} {pct:.0f}%")
    except Exception:
        row("disk", "?", "")

    # `df -i` and `--output` are mutually exclusive on GNU coreutils, so parse
    # the positional columns: Filesystem Inodes IUsed IFree IUse% Mounted
    out = run(["df", "-i", "/"])
    if out:
        parts = out.strip().splitlines()[-1].split()
        try:
            total_i, used_i = int(parts[1]), int(parts[2])
            ipct = used_i / total_i * 100 if total_i else 0
            row("inodes", f"{human_count(used_i)} / {human_count(total_i)}",
                f"{bar(ipct)} {ipct:.0f}%")
        except (IndexError, ValueError):
            pass

    # Needs root; -n so it never blocks on a password prompt. Silently skipped
    # if sudo is unavailable -- this is a nice-to-have, not a health signal.
    out = run(["sudo", "-n", "du", "-sb", "/var/lib/docker/containers"])
    if out:
        try:
            row("docker logs", human_bytes(int(out.split()[0])),
                "rotation on (50 MB × 3)")
        except (IndexError, ValueError):
            pass

    out = run(["docker", "ps", "--format", "{{.Names}}\t{{.Status}}"])
    if out:
        lines = [ln for ln in out.strip().splitlines() if ln.strip()]
        relevant = [ln for ln in lines
                    if any(k in ln for k in ("celery", "navsat", "redis", "postgres"))]
        down = [ln.split("\t")[0] for ln in relevant if "Up" not in ln]
        if down:
            row("containers", red(f"{len(down)} not running"), ", ".join(down))
        else:
            row("containers", green(f"{len(relevant)} up"), "collectors, broker, db")
    print()


def main() -> int:
    now = datetime.now(timezone.utc)
    print()
    print(f"  {bold('SIMOVI COLLECTORS')}{'':>8}{dim(now.strftime('%a %d %b %Y · %H:%M:%S UTC'))}")
    print()

    states = [
        feed_panel("MBTA", "mbta", now, cadence="5s", flush_minute=2),
        feed_panel("bUCR", "navsat", now, cadence="15s", flush_minute=0,
                   extra_lines=[("window", "06:00–23:00 Costa Rica",
                                 "open" if read_status("navsat").get("in_window") else "CLOSED — not polling")]),
    ]
    states.append(tu_panel(now))
    states.append(compaction_panel(now))
    storage_panel(now)
    host_panel()

    if "bad" in states:
        print(f"  {red('One or more checks need attention.')}")
        print(f"  {dim('logs: docker logs --tail 50 gtfs-rt-pipeline-celery-worker-1')}")
        print()
        return 1
    print(f"  {dim('events: tail -f ' + STATUS_DIR + '/*.events.log')}")
    print()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
